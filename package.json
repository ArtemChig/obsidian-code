{
  "name": "obsidian-code",
  "productName": "Obsidian Code",
  "version": "1.1.3",
  "private": true,
  "description": "A private desktop Claude Code-style agent app for open-weight models (local llama-server, Vast.ai GPUs, any OpenAI-compatible endpoint).",
  "author": "Obsidian Code",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "core": "tsx src/core/standalone.ts",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.web-tests.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@mozilla/readability": "^0.6.0",
    "@vscode/ripgrep": "^1.18.0",
    "croner": "^10.0.1",
    "diff": "^9.0.0",
    "electron-updater": "^6.8.10",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "linkedom": "^0.18.13",
    "nanoid": "^6.0.2",
    "picomatch": "^4.0.7",
    "ssh2": "^1.17.0",
    "strip-ansi": "^7.2.0",
    "tree-kill": "^1.2.2",
    "turndown": "^7.2.4",
    "ws": "^8.22.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@fontsource/chivo": "^5.3.0",
    "@fontsource/chivo-mono": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@radix-ui/react-collapsible": "^1.2.0",
    "@radix-ui/react-context-menu": "^2.4.0",
    "@radix-ui/react-dialog": "^1.3.0",
    "@radix-ui/react-dropdown-menu": "^2.2.0",
    "@radix-ui/react-popover": "^1.3.0",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.0",
    "@radix-ui/react-switch": "^1.4.0",
    "@radix-ui/react-tabs": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/diff": "^7.0.2",
    "@types/node": "^24.19.2",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.4",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "electron-winstaller": true,
    "esbuild": true,
    "ssh2": false
  }
}
